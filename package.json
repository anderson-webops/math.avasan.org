{
	"name": "math-avasan-org",
	"type": "module",
	"version": "1.0.10",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Public math courses and browser-based graphing for Julio's students",
	"author": "Math with Julio",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end"
	],
	"scripts": {
		"audit": "npm audit --workspaces --audit-level=low",
		"audit:production": "npm audit --workspaces --omit=dev --audit-level=low",
		"audit:signatures": "npm audit signatures",
		"audit:static-media": "node scripts/audit-static-course-media.mjs",
		"audit-fix": "npm audit fix --workspaces",
		"build": "npm run -w front-end build",
		"dev": "npm run -w front-end dev",
		"serve": "npm run -w front-end serve",
		"a11y": "node scripts/a11y-smoke.mjs",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run lint:root && npm run -w front-end lint",
		"lint:root": "eslint \"scripts/{audit-static-course-media,static-media-request,verify-*}.mjs\" eslint.config.js",
		"lint-fix": "npm run -w front-end lint-fix",
		"test": "npm run -w front-end test:unit",
		"test:static-media-request": "npm run -w front-end test:unit -- test/static-media-request.spec.test.ts",
		"typecheck": "npm run -w front-end typecheck",
		"up": "npm exec --yes -- taze major -I && npm run -w front-end up",
		"verify:dependency-graph": "node scripts/verify-dependency-graph.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"verify:production": "node scripts/post-deploy-smoke.mjs"
	},
	"overrides": {
		"defu": "6.1.6",
		"eslint-plugin-import": {
			"minimatch": "^3.1.5"
		},
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4",
		"glob": "13.0.6",
		"js-yaml": "4.3.0",
		"linkify-it": "6.1.0",
		"postcss": "8.5.24",
		"shell-quote": "1.10.0",
		"svgo": "4.0.2",
		"systeminformation": "5.33.1",
		"tar": "7.5.22",
		"valibot": "1.4.2",
		"@vue/language-core": {
			"minimatch": "^10.2.6"
		},
		"path-to-regexp": "8.4.0",
		"serialize-javascript": "7.0.5",
		"picomatch": "4.0.4",
		"anymatch": {
			"picomatch": "2.3.2"
		},
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"readdirp": {
			"picomatch": "2.3.2"
		},
		"@rollup/plugin-babel": {
			"@rollup/pluginutils": {
				"picomatch": "2.3.2"
			}
		},
		"@rollup/plugin-replace": {
			"@rollup/pluginutils": {
				"picomatch": "2.3.2"
			}
		},
		"vite": "^8.2.0",
		"vue-router": "^5.2.0",
		"undici": "7.28.0",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.15.2"
		}
	},
	"allowScripts": {
		"cypress@15.19.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.4.0": false,
		"simple-git-hooks@2.13.1": true
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"axe-core": "^4.12.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"puppeteer": "^25.4.0",
		"taze": "^19.16.0",
		"tsx": "^4.23.4",
		"typescript": "^6.0.3"
	}
}
