{
	"name": "math-avasan-org",
	"type": "module",
	"version": "1.0.3",
	"private": true,
	"packageManager": "npm@11.16.0",
	"engines": {
		"node": ">=24.18.0 <25",
		"npm": ">=11.16.0 <12"
	},
	"description": "Public math courses and browser-based graphing for Julio's students",
	"author": "Math with Julio",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end"
	],
	"scripts": {
		"audit": "npm audit --workspaces",
		"audit:static-media": "node scripts/audit-static-course-media.mjs",
		"audit-fix": "npm audit fix --workspaces",
		"build": "npm run -w front-end build",
		"dev": "npm run -w front-end dev",
		"serve": "npm run -w front-end serve",
		"a11y": "node scripts/a11y-smoke.mjs",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run -w front-end lint",
		"lint-fix": "npm run -w front-end lint-fix",
		"typecheck": "npm run -w front-end typecheck",
		"up": "npm exec --yes -- taze major -I && npm run -w front-end up",
		"verify:production": "node scripts/post-deploy-smoke.mjs"
	},
	"overrides": {
		"defu": "6.1.6",
		"eslint-plugin-import": {
			"minimatch": "^3.1.5"
		},
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4",
		"glob": "13.0.6",
		"js-yaml": "4.3.0",
		"linkify-it": "5.0.2",
		"postcss": "8.5.24",
		"shell-quote": "1.10.0",
		"svgo": "4.0.2",
		"systeminformation": "5.33.1",
		"tar": "7.5.22",
		"valibot": "1.4.2",
		"@vue/language-core": {
			"minimatch": "^9.0.9"
		},
		"path-to-regexp": "8.4.0",
		"serialize-javascript": "7.0.5",
		"picomatch": "4.0.4",
		"anymatch": {
			"picomatch": "2.3.2"
		},
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"readdirp": {
			"picomatch": "2.3.2"
		},
		"@rollup/plugin-babel": {
			"@rollup/pluginutils": {
				"picomatch": "2.3.2"
			}
		},
		"@rollup/plugin-replace": {
			"@rollup/pluginutils": {
				"picomatch": "2.3.2"
			}
		},
		"vite": "^8.0.8",
		"vue-router": "^5.0.4",
		"undici": "7.28.0",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.15.2"
		}
	},
	"allowScripts": {
		"cypress@15.19.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"puppeteer@24.43.1": true,
		"simple-git-hooks@2.13.1": true
	},
	"devDependencies": {
		"@antfu/eslint-config": "^8.2.0",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"axe-core": "^4.11.4",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"puppeteer": "^24.43.1",
		"taze": "^19.11.0",
		"tsx": "4.23.1",
		"typescript": "^6.0.3"
	}
}
