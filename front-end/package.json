{
	"name": "front-end",
	"version": "2.0.0",
	"description": "Public math courses and a browser-based Graph Sketcher",
	"author": "Math with Julio",
	"keywords": [],
	"license": "ISC",
	"type": "module",
	"private": true,
	"main": "dist/script.js",
	"scripts": {
		"build": "vite-ssg build && node scripts/normalize-static-routes.mjs && node scripts/write-release-metadata.mjs && node scripts/verify-built-security.mjs",
		"dev": "vite --port 3333 --open",
		"start": "vite --port 3333 --open --host",
		"serve": "vite --port 3333 --open --host",
		"preview": "vite preview",
		"preview-https": "serve dist",
		"test": "vitest run",
		"test:e2e": "cypress open",
		"test:unit": "vitest run",
		"typecheck": "vue-tsc --noEmit",
		"up": "npm exec --yes -- taze major -I",
		"postinstall": "npx simple-git-hooks",
		"lint": "eslint \"src/**/*.{js,ts,vue}\"",
		"lint-fix": "eslint \"src/**/*.{js,ts,vue}\" --fix"
	},
	"dependencies": {
		"@unhead/vue": "^3.0.2",
		"@vueuse/core": "^14.2.1",
		"fflate": "^0.8.3",
		"markdown-it": "^14.3.0",
		"nprogress": "^0.2.0",
		"pinia": "^3.0.4",
		"vite-plugin-vue-layouts-next": "^2.1.0",
		"vue": "^3.5.31",
		"vue-router": "^5.0.4"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@types/nprogress": "^0.2.3",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vue/test-utils": "^2.4.11",
		"beasties": "^0.4.3",
		"cypress": "^15.19.0",
		"eslint-plugin-format": "^2.0.1",
		"lint-staged": "^16.4.0",
		"simple-git-hooks": "^2.13.1",
		"typescript-eslint": "^8.65.0",
		"unplugin-auto-import": "^21.0.0",
		"unplugin-vue-components": "^32.0.0",
		"vite": "^8.0.8",
		"vite-ssg": "^28.3.0",
		"vite-ssg-sitemap": "^0.10.0",
		"vitest": "^4.1.5",
		"vue-eslint-parser": "^10.4.0",
		"vue-tsc": "^3.2.6"
	},
	"optionalDependencies": {
		"@oxc-resolver/binding-linux-arm64-gnu": "^11.17.0"
	},
	"resolutions": {
		"unplugin": "^3.0.0",
		"vite": "^8.0.8",
		"vue-router": "^5.0.4"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{ts,js,vue}": [
			"eslint --fix"
		]
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead",
		"not ie 11"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anderson-webops/math.avasan.org"
	},
	"bugs": {
		"url": "https://github.com/anderson-webops/math.avasan.org/issues"
	},
	"homepage": "https://math.avasan.org"
}
